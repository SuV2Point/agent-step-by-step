# ============================================
# 配置模板文件
# 使用方法：把这个文件复制一份，重命名为 .env，然后填入你自己的真实配置。
# .env 文件已被 .gitignore 忽略，不会提交到 git，密钥很安全。
# ============================================

# 模型服务的接口地址（OpenAI 兼容协议）。
# 例如：
#   OpenAI 官方      -> https://api.openai.com/v1
#   DeepSeek         -> https://api.deepseek.com/v1
#   通义千问(阿里)    -> https://dashscope.aliyuncs.com/compatible-mode/v1
#   某个中转站        -> https://xxx.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 你的 API 密钥
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 要使用的模型名称，例如 deepseek-chat / gpt-4o-mini / qwen-plus 等
LLM_MODEL=deepseek-chat
